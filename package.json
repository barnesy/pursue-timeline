{
  "name": "pursue-timeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "recon": "tsx scripts/recon.ts",
    "fetch-csv": "tsx scripts/fetch-csv.ts",
    "inspect": "tsx scripts/inspect.ts",
    "sync-data": "cp data/cases.json public/cases.json && cp data/nuclear-tests.json public/nuclear-tests.json && cp data/nuclear-incidents.json public/nuclear-incidents.json && cp data/stargate.json public/stargate.json",
